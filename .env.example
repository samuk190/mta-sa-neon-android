# =============================================================================
# MTA SA NEON ANDROID - Environment Configuration
# =============================================================================
# Note: You MUST provide your own original GTA San Andreas Mobile v2.10 files.
# Proprietary Rockstar Games assets and libraries are NOT distributed in this repository.

# Path to your local GTA San Andreas Mobile 2.10 extracted game assets folder.
# This directory should contain the extracted files from GTA Mobile 2.10:
#   - anim/
#   - audio/
#   - data/ (gta.dat, handling.cfg, etc.)
#   - models/
#   - texdb/ (gta3.img, etc.)
# Examples:
#   GAME_ASSETS_DIR=/home/user/games/gtasa_mobile_2.10/assets
#   GAME_ASSETS_DIR=C:/Games/GTA_SA_2.10/assets
#   GAME_ASSETS_DIR=./game_assets
GAME_ASSETS_DIR=./game_assets

# Target storage directory on the Android device/emulator:
# Default app external files directory accessible without root:
DEVICE_ASSETS_PATH=/sdcard/Android/data/com.worldrpg.neonlauncher/files/game_assets

# Optional: Custom CDN or Local HTTP Server URL if you prefer serving assets over network
# e.g., run `python3 -m http.server 8080` in your assets folder, and point to:
# CDN_ROOT_URL=http://10.0.2.2:8080
CDN_ROOT_URL=

# Default MTA Server Connection Settings
DEFAULT_SERVER_IP=127.0.0.1
DEFAULT_SERVER_PORT=22003
DEFAULT_PLAYER_NICK=MTA_Player
