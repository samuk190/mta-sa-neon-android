<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:theme="@style/ThemeOverlay.BrowserSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/BrowserText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            style="@style/BrowserButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/save_settings" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/settingsColumns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/gameColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/section_graphics" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/graphicsToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGraphicsLow"
                            style="@style/SettingsGraphicsOption"
                            android:text="@string/graphics_low" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGraphicsMedium"
                            style="@style/SettingsGraphicsOption"
                            android:text="@string/graphics_medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGraphicsHigh"
                            style="@style/SettingsGraphicsOption"
                            android:text="@string/graphics_high" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/section_audio" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/BrowserText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/audio_volume" />

                        <TextView
                            android:id="@+id/volumeValue"
                            style="@style/BrowserText.SettingsValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/audio_volume"
                        android:stepSize="1"
                        android:value="80"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:labelBehavior="gone" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/section_controls" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/BrowserText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touch_sensitivity" />

                        <TextView
                            android:id="@+id/touchValue"
                            style="@style/BrowserText.SettingsValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderTouchSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/touch_sensitivity"
                        android:stepSize="1"
                        android:value="5"
                        android:valueFrom="1"
                        android:valueTo="10"
                        app:labelBehavior="gone"
                        app:tickVisible="true" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/section_interface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/BrowserText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/interface_scale" />

                        <TextView
                            android:id="@+id/interfaceScaleValue"
                            style="@style/BrowserText.SettingsValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderInterfaceScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/interface_scale"
                        android:stepSize="5"
                        android:value="100"
                        android:valueFrom="50"
                        android:valueTo="150"
                        app:labelBehavior="gone" />

                    <TextView
                        style="@style/BrowserText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/interface_scale_description" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetInterfaceScale"
                        style="@style/BrowserButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interface_scale_default" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLauncherLanguage"
                        style="@style/BrowserButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/launcherColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/neon_account_title" />

                    <TextView
                        android:id="@+id/neonAccountStatus"
                        style="@style/BrowserText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/neon_account_disconnected" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNeonAccount"
                        style="@style/BrowserButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/neon_account_sign_in" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsPanel">
                    <TextView
                        style="@style/BrowserText.SettingsHeading"
                        android:text="@string/section_assets" />

                    <TextView
                        style="@style/BrowserText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/assets_description" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_assets"
                        style="@style/BrowserButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sync_assets"
                        android:tag="btn_sync_assets"
                        app:icon="@drawable/ic_cloud_download" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestGta"
                        style="@style/BrowserButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/test_gta"
                        android:enabled="false"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsPanel">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchEngineDebug"
                        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:fontFamily="@font/sa_bank_gothic"
                        android:text="@string/engine_debug"
                        android:textColor="@color/browser_paper" />

                    <TextView
                        style="@style/BrowserText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/engine_debug_description" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
