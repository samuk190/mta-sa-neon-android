<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WorldRPGNeon" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1B5E20</item>
        <item name="colorPrimaryVariant">#003300</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF6F00</item>
        <item name="colorSecondaryVariant">#E65100</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/colorPrimaryVariant</item>
    </style>

    <style name="Theme.WorldRPGNeon.Fullscreen" parent="Theme.WorldRPGNeon">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <color name="colorPrimaryVariant">#003300</color>
</resources>