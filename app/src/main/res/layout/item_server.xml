<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardServer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/browser_card"
    app:cardCornerRadius="5dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/browser_line">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="53dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.WorldRPGNeon.Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvServerName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/BrowserText"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <ImageView
                    android:id="@+id/androidBadge"
                    android:layout_width="26dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="3dp"
                    android:background="@drawable/browser_panel"
                    android:src="@drawable/ic_android"
                    android:contentDescription="@string/browser_android_supported"
                    android:tooltipText="@string/browser_android_supported"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivLock"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="yes"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/browser_muted"
                    android:contentDescription="@string/passworded" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGameMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/BrowserText.Small"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/countries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BrowserText.Small"
            android:maxLines="1"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorite"
            style="@style/BrowserIcon"
            android:contentDescription="@string/toggle_favorite"
            app:icon="@drawable/ic_star_outline" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvPlayerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BrowserText.Small" />

            <TextView
                android:id="@+id/tvPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BrowserText.Small" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BrowserButton"
            android:text="@string/browser_connect"
            app:icon="@drawable/ic_play" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
